  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1b2c3d4e5f6789012345678abcde002, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookTitle: There is Light
  bookAuthor: Andrew Freeman (2026)
  bookDescription: The idea and inspiration behind there is light video games that
    built in my internship with Persevere Now and The Verse is I have been experiencing
    some grief and depression in my life the passing of some family members and S
    so I figured the tools and techniques I use to help get me through this. In my
    life I could possibly implement into a video game and so I chose the music Uh
    I chose the voice overs because uh wise and inspirational quotes and classical
    music is what helped me get through my grief and depression from my losses and
    so I if I could help somebody in the same manner that I found help then it would
    be greatSome of the hard skills I learned while building this video game was
    C sharp i've never done C sharp I don't think it was in the curriculum with the
    Persevere program and what a gaming framework looks like and what a game engine
    looks like And to know the difference between the two and the capabilities that
    each independently have from 1 another are some of the harsh skills that I learn
    and going from VS code to Microsoft Visual Studio Code Yes they're both visual
    studios you can build code in them but Quite a bit of different and to build
    this video game Microsoft Visual Studio was the chosen route of the Unity game
    engine and some of the soft skills I had to learn while building this game with
    the internship with the persevere now was to learn how to work as a team and
    stay abreast with our teammates with progress and my mentor and to give any feedback
    or help along the way for any of the other interns there was something new 'cause
    I haven't worked as a team on a project before
  websiteUrl: https://afreeman86.itch.io/there-is-light
  screenshots:
  - {fileID: 2800000, guid: 27e091e3a580ff044a9ac709afae52ee, type: 3}
  - {fileID: 2800000, guid: 1d315b3a353b13643bfef1a87b4d67c4, type: 3}
  - {fileID: 2800000, guid: 32941d0a0031adc42a002145cdf06e4e, type: 3}
  - {fileID: 2800000, guid: 961969295c85ae54bb97cb747823c9b2, type: 3}
  bookCanvas: {fileID: 1971564975}
  interactRadius: 2
